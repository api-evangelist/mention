{
  "item": [
    {
      "id": "df48c707-11cf-47dc-9c11-0ed8d030c397",
      "name": "Mentions",
      "description": {
        "content": "The results an alert collects, plus curation and streaming.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "39673bb1-e74d-4b67-9f90-d2b9c585bbff",
          "name": "Fetch mentions",
          "request": {
            "name": "Fetch mentions",
            "description": {
              "content": "Returns the mentions collected by an alert. The query string carries the filter surface; every filter is optional. Retrieve older mentions by following _links.more and poll for new ones by following _links.pull. The index_version attribute of the alert determines which filters are available to it.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "alerts",
                ":alert_id",
                "mentions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": true,
                  "key": "since_id",
                  "value": "<string>",
                  "description": "Return mentions with an id greater (more recently found) than the given id. Cannot be combined with before_date, not_before_date or cursor."
                },
                {
                  "disabled": true,
                  "key": "before_date",
                  "value": "<string>",
                  "description": "Return mentions published before the provided date, ordered by publication date."
                },
                {
                  "disabled": true,
                  "key": "not_before_date",
                  "value": "<string>",
                  "description": "Ignore mentions older than the given date. Only allowed when before_date is provided."
                },
                {
                  "disabled": true,
                  "key": "limit",
                  "value": "<string>",
                  "description": "Number of mentions to return. Default 20, maximum 1000. A small limit gives faster responses."
                },
                {
                  "disabled": true,
                  "key": "source",
                  "value": "<string>",
                  "description": "Restrict to one of the available sources. Only available to plans with search access."
                },
                {
                  "disabled": true,
                  "key": "unread",
                  "value": "<string>",
                  "description": "Return only unread mentions. Cannot be combined with favorite, q or tone."
                },
                {
                  "disabled": true,
                  "key": "favorite",
                  "value": "<string>",
                  "description": "Return only favorite mentions. Cannot be combined with folder unless folder is inbox or archive."
                },
                {
                  "disabled": true,
                  "key": "folder",
                  "value": "<string>",
                  "description": "Filter by folder: inbox, archive, spam or trash. With spam and trash, include_children defaults to enabled."
                },
                {
                  "disabled": true,
                  "key": "tone",
                  "value": "<string>",
                  "description": "Filter by tone: -1 negative, 0 neutral, 1 positive. Accepts an array of values."
                },
                {
                  "disabled": true,
                  "key": "countries",
                  "value": "<string>",
                  "description": "Filter by country. Accepts an array of values."
                },
                {
                  "disabled": true,
                  "key": "include_children",
                  "value": "<string>",
                  "description": "Whether to include children mentions."
                },
                {
                  "disabled": true,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort results by published_at, author_influence.score, direct_reach, cumulative_reach or domain_reach. Only allowed on plans with search access."
                },
                {
                  "disabled": true,
                  "key": "languages",
                  "value": "<string>",
                  "description": "Filter by language. Accepts an array of values."
                },
                {
                  "disabled": true,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "Timezone used when parsing dates in the q parameter."
                },
                {
                  "disabled": true,
                  "key": "q",
                  "value": "<string>",
                  "description": "Keyword / compound filter expression, e.g. source:(facebook OR twitter) in:(inbox OR archive) is:favorite. Only accounts with search access can use it."
                },
                {
                  "disabled": true,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor supplied by the API."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) ID of the account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "alert_id",
                  "description": "(Required) ID of the alert."
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Accept-Version",
                "value": "{{apiVersion}}"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": []
        },
