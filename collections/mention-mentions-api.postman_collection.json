        {
          "id": "139acf49-e277-4d27-9a0b-bd2f7dfb9927",
          "name": "Curate a mention",
          "request": {
            "name": "Curate a mention",
            "description": {
              "content": "Updates the curation state of a mention: folder, tags, tone, read/favorite/trashed flags. The content and source of a mention cannot be modified. Any property may be omitted. Marking a mention favorite automatically marks it read. Tags must already exist on the alert.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "alerts",
                ":alert_id",
                "mentions",
                ":mention_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) ID of the account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "alert_id",
                  "description": "(Required) ID of the alert."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "mention_id",
                  "description": "(Required) ID of the mention."
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Accept-Version",
                "value": "{{apiVersion}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favorite\": true,\n  \"trashed\": false,\n  \"read\": true,\n  \"tags\": [\n    {\n      \"id\": 123\n    }\n  ],\n  \"folder\": \"archive\",\n  \"tone\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
