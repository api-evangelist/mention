{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mention Tags API",
    "version": "1.21"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch all tags of an alert",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mention.net/api/accounts/:account_id/alerts/:alert_id/tags",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "alert_id",
                "value": "",
                "type": "path"
              }
            ],
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "name": "Accept-Version",
                "value": "{{apiVersion}}"
              }
            ]
          },
          "docs": "Lists the tags defined on an alert, with the number of mentions carrying each tag."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mention.net/api/accounts/:account_id/alerts/:alert_id/tags",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "alert_id",
                "value": "",
                "type": "path"
              }
            ],
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "name": "Accept-Version",
                "value": "{{apiVersion}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": {
                "name": "space innovation"
              }
            }
          },
          "docs": "Creates a tag available to every mention of the alert. An alert is limited to 100 tags, a tag name to 20 characters, and the auto-tagging keywords list to 5 keywords."
        },
        {
          "info": {
            "name": "Rename a tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mention.net/api/accounts/:account_id/alerts/:alert_id/tags/:tag_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "alert_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ],
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "name": "Accept-Version",
                "value": "{{apiVersion}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": {
                "name": "space new technos"
              }
            }
          },
          "docs": "Modifies an existing tag's label or auto-tagging keywords. Mentions stay linked to the tag by id, so renaming a tag does not detach it from the mentions already carrying it."
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mention.net/api/accounts/:account_id/alerts/:alert_id/tags/:tag_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "alert_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ],
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "name": "Accept-Version",
                "value": "{{apiVersion}}"
              }
            ]
          },
          "docs": "Deletes a tag from the alert."
        }
      ]
    }
  ]
}