                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Space innovation\",\n  \"query\": {\n    \"type\": \"advanced\",\n    \"query_string\": \"(space AND innovation)\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
