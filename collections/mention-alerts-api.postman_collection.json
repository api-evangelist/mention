{
  "item": [
    {
      "id": "530bb98b-5e45-4df5-b4ee-793e14a845df",
      "name": "Alerts",
      "description": {
        "content": "The keyword queries Mention crawls the web and social media for.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ff08f6e8-7d71-45f0-bf99-66f44cd4423e",
          "name": "Fetch all alerts of an account",
          "request": {
            "name": "Fetch all alerts of an account",
            "description": {
              "content": "Returns the alerts visible to the account. The collection is paginated with an opaque cursor; follow _links.more to page. Since API version 1.21 the stats field is empty by default \u2014 request counters explicitly with the stats query string parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": true,
                  "key": "limit",
                  "value": "<string>",
                  "description": "Number of alerts to return. Default: return all alerts."
                },
                {
                  "disabled": true,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor supplied by the API in _links.more."
                },
                {
                  "disabled": true,
                  "key": "ids",
                  "value": "<string>",
                  "description": "IDs of the alerts to fetch. Must not contain more than 50 ids."
                },
                {
                  "disabled": true,
                  "key": "stats",
                  "value": "<string>",
                  "description": "Comma-separated list of alert counters to include. One or more of mention_folders.inbox.total, mention_folders.archive.total, mention_folders.spam.total, mention_folders.trash.total, unread_mentions.total, unseen_mentions.total, favorite_mentions.total, tasks.total, todo_tasks, done_tasks, logs.total. Added in API version 1.21."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) ID of the account."
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Accept-Version",
                "value": "{{apiVersion}}"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": []
        },
        {
          "id": "948dfd8f-4489-4b8c-8bb3-b0cc7546eeee",
          "name": "Create an alert",
          "request": {
            "name": "Create an alert",
            "description": {
              "content": "Creates a new alert for the account. A query is either basic (included / required / excluded keyword arrays) or advanced (a boolean query_string). At least one of included_keywords or required_keywords must carry a keyword. Since API version 1.21 the group_id query string parameter is always mandatory.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": true,
                  "key": "group_id",
                  "value": "<string>",
                  "description": "(Required) Group the alert belongs to. Mandatory since API version 1.21; before 1.21 it could be omitted when the caller had only one group."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) ID of the account."
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Accept-Version",
                "value": "{{apiVersion}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NASA and competitors\",\n  \"query\": {\n    \"type\": \"basic\",\n    \"included_keywords\": [\n      \"NASA\",\n      \"Arianespace\",\n      \"SpaceX\"\n    ]\n  },\n  \"languages\": [\n    \"en\"\n  ],\n  \"sources\": [\n    \"web\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
