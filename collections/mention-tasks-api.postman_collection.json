          "name": "Fetch all tasks of an alert",
          "request": {
            "name": "Fetch all tasks of an alert",
            "description": {
              "content": "Returns every mention task created on the alert, so open assignments can be reviewed in one call. There is no separate endpoint for the tasks of a single mention: those are returned inline by the mention resource.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "alerts",
                ":alert_id",
                "tasks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) ID of the account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "alert_id",
                  "description": "(Required) ID of the alert."
                }
              ]
