              },
              {
                "name": "interval",
                "value": "",
                "type": "query"
              },
              {
                "name": "favorite",
                "value": "",
                "type": "query"
              },
              {
                "name": "important",
                "value": "",
                "type": "query"
              },
              {
                "name": "week_day_stats",
                "value": "",
                "type": "query"
              },
              {
                "name": "week_day_by_hour_stats",
                "value": "",
